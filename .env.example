# -----------------------------------------------------------------------------
# NORINA - Environment Variables
# Copy this file to .env and fill in real values. Never commit the real .env file.
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL - Supabase / Neon) ---
DATABASE_URL="postgresql://user:password@localhost:5432/norina?schema=public"

# --- NextAuth.js (Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# --- Google OAuth Provider ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (order confirmations, password reset, etc.) ---
# Provider TBD (Resend / SendGrid) - see spec section 2
RESEND_API_KEY=""

# --- Payments (U-PAY via Summit's management console) ---
# "mock" (default, for local dev/testing) or "upay" once the integration below is finished.
PAYMENT_PROVIDER="mock"
# TODO: real field names are a guess until we have U-PAY's API docs - see
# src/lib/payments/upay-summit-provider.ts for the integration TODO.
UPAY_MERCHANT_ID=""
UPAY_API_KEY=""
UPAY_WEBHOOK_SECRET=""

# --- File storage for product images ---
# Provider TBD (Supabase Storage / Cloudflare R2 / AWS S3) - see spec section 2
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
