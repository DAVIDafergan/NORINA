// NORINA - Prisma schema
// See DECISIONS.md for design notes on fields that go beyond the literal spec
// (slugs, i18n JSON shape, Decimal money fields, NextAuth-required models, etc).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Localized text is stored as JSON: { "he": "...", "fr": "...", "en": "..." }
model Category {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       Json
  orderIndex Int       @default(0)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        Json
  description Json
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  basePrice   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)

  /// Optional richer catalog copy, all localized `{ he, fr, en }` JSON like `name`/`description`.
  /// Nullable because they were added after stage 2 - older rows just don't have them yet.
  materials         Json?
  careInstructions  Json?
  additionalInfo    Json?

  colors   Color[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

/// A color belongs to a single product and owns its own image gallery.
model Color {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       Json
  hexCode    String
  orderIndex Int     @default(0)

  images   ColorImage[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

/// One image in a color's gallery. `order` controls display order in the admin/storefront.
/// `isPrimary` marks the cover thumbnail shown wherever only one image fits (product
/// cards, order line items) - independent of display order in the full gallery.
/// `url` is currently a base64 data: URL stored directly in Postgres (no object storage
/// provider configured yet - see DECISIONS.md). Fine for a boutique catalog's volume;
/// swap for real storage (S3/R2/Supabase) later without changing this shape.
model ColorImage {
  id        String  @id @default(cuid())
  colorId   String
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([colorId])
}

/// Shared size labels (S, M, L, 38, 40, ...), reused across products via ProductVariant.
/// Measurement ranges (cm) are optional and global to the size, not per-product/category -
/// consistent with sizes already being a global pool (see DECISIONS.md stage 2). Powers the
/// customer-facing size recommender; a size with no ranges set is simply skipped by it.
model Size {
  id         String @id @default(cuid())
  label      String @unique
  orderIndex Int    @default(0)

  bustMin  Int?
  bustMax  Int?
  waistMin Int?
  waistMax Int?
  hipsMin  Int?
  hipsMax  Int?

  variants ProductVariant[]
}

/// The actual sellable unit: one product + one color + one size.
/// stock_quantity lives here on purpose - see spec section 8 ("כלל הזהב").
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId       String
  color         Color    @relation(fields: [colorId], references: [id], onDelete: Cascade)
  sizeId        String
  size          Size     @relation(fields: [sizeId], references: [id])
  sku           String   @unique
  stockQuantity Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colorId, sizeId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Users & Auth
// (Account / Session / VerificationToken follow the NextAuth.js Prisma
// adapter's required shape - field names must stay as-is for the adapter
// to work without a custom mapping. See DECISIONS.md.)
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Hashed password for the email/password provider. Null for OAuth-only users.
  password      String?
  role          Role      @default(CUSTOMER)
  isBlocked     Boolean   @default(false)

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Used by NextAuth for email magic links, and reused for password-reset tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// userId is nullable so a guest checkout order (stage 6) can have a one-off
/// address that isn't attached to any saved account.
model Address {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  city   String
  street String
  zip    String?
  phone  String
  notes  String?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  SHIPPING
  PICKUP
}

model Order {
  id           String       @id @default(cuid())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  status       OrderStatus  @default(PENDING)
  deliveryType DeliveryType

  /// Snapshotted at checkout time - always present, for both guest and
  /// logged-in orders (the recipient/contact may differ from the account).
  contactName  String
  contactEmail String
  contactPhone String
  notes        String?

  /// Used when deliveryType is SHIPPING.
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  /// Used when deliveryType is PICKUP - a real FK to the admin-managed list
  /// (see spec section 4.5), not a free-text city.
  pickupLocationId String?
  pickupLocation   PickupLocation? @relation(fields: [pickupLocationId], references: [id])

  shippingCost Decimal @db.Decimal(10, 2)
  totalAmount  Decimal @db.Decimal(10, 2)

  /// Set by the payment adapter (see src/lib/payments) - which provider handled
  /// this order and its reference so we can look it up on the provider's side.
  paymentProvider  String?
  paymentReference String?
  paidAt           DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  priceAtPurchase  Decimal        @db.Decimal(10, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

/// Singleton config row (app layer always reads/writes the first row).
model ShippingSetting {
  id                String   @id @default(cuid())
  flatRatePrice     Decimal  @db.Decimal(10, 2)
  freeShippingAbove Decimal? @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt
}

model PickupLocation {
  id       String  @id @default(cuid())
  cityName Json
  address  String
  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
